{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Generate sample data",
      "type": "debugpy", "request": "launch",
      "module": "sprint_health.generate_data",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal"
    },
    {
      "name": "2. Build status report",
      "type": "debugpy", "request": "launch",
      "module": "sprint_health.report",
      "args": ["--split", "4"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal"
    },
    {
      "name": "3. Open dashboard (Streamlit)",
      "type": "debugpy", "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal"
    },
    {
      "name": "Run tests",
      "type": "debugpy", "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
